// Environment variable configuration
// Copy this file to .env.local and fill in your values

# ─── Database (Supabase PostgreSQL / Neon) ───────────────────────────────────
DATABASE_URL=postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL_UNPOOLED=postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ─── Supabase Storage ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
STORAGE_BUCKET=assignments


# ─── Cron Job Protection ───────────────────────────────────────────────────────
CRON_SECRET=your-random-cron-secret-token

# ─── App URL ───────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
