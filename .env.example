// Environment variable configuration
// Copy this file to .env.local and fill in your values

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Auth.js ──────────────────────────────────────────────────────────────────
AUTH_SECRET=your-super-secret-auth-key-min-32-chars

# ─── Google OAuth (https://console.cloud.google.com/) ─────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Cloudflare R2 Storage ────────────────────────────────────────────────────
# Get from: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
STORAGE_ACCOUNT_ID=your-cloudflare-account-id
STORAGE_ACCESS_KEY=your-r2-access-key-id
STORAGE_SECRET_KEY=your-r2-secret-access-key
STORAGE_BUCKET=assignments-bucket
STORAGE_PUBLIC_URL=https://your-public-bucket-url.r2.dev

# ─── Cron Job Protection ───────────────────────────────────────────────────────
CRON_SECRET=your-random-cron-secret-token

# ─── App URL ───────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
